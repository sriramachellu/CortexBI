# Required - app refuses to boot without this
JWT_SECRET_KEY=change-me-to-a-random-secret

# Database (defaults match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://cortexbi:cortexbi_dev@localhost:5432/cortexbi

# LLM — any OpenAI-compatible API
# Examples:
#   NVIDIA Build: https://integrate.api.nvidia.com/v1  (model: nvidia/nemotron-3.5-lightning-30b-a3b) — FREE
#   OpenRouter:   https://api.openrouter.ai/v1         (model: moonshotai/kimi-k2)
#   DeepSeek:     https://api.deepseek.com/v1          (model: deepseek-chat)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Object storage: "local" for dev, "s3" for prod
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=

# Analysis guardrails
MAX_UPLOAD_SIZE_MB=200
MAX_UPLOAD_ROWS=1000000
SAMPLE_ROWS=300000
MAX_COLUMNS=100
SHAP_SAMPLE_SIZE=1000
MAX_TOKENS_PER_ANALYSIS=5000
